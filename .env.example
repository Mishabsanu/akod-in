# Copy to .env.local for development. In production set these in the host's environment.

# Base URL of the AKOD ECO app (products and categories come from its /api/storefront/catalog)
AKOD_ECO_API_URL=http://localhost:3000

# Only if STOREFRONT_API_KEY is set in AKOD ECO: the same value here
STOREFRONT_API_KEY=

# How often (seconds) the store re-reads the catalog from AKOD ECO
CATALOG_REVALIDATE_SECONDS=60
